# Waka3x Environment Configuration
# Copy this file to .env and fill in your values
# These values will be used as Docker secrets when running docker compose

# Password Salt (required)
# Generate a random 32-character string for security
# Example: cat /dev/urandom | LC_ALL=C tr -dc 'a-zA-Z0-9' | fold -w 32 | head -n 1
WAKA3X_PASSWORD_SALT=changeme_generate_random_32_chars

# Database Password (required)
# Used by both waka3x service and postgres database
WAKA3X_DB_PASSWORD=changeme_secure_db_password

# SMTP Password (optional)
# Only needed if you want to enable email reports
WAKA3X_MAIL_SMTP_PASS=changeme_smtp_password
